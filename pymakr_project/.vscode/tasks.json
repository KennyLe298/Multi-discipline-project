{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Upload main.py only",
      "type": "process",
      "command": "mpremote",
      "args": [
        "connect",
        "${input:serialPort}",
        "resume",
        "fs",
        "cp",
        "main.py",
        ":main.py",
        "+",
        "reset"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Open REPL",
      "type": "process",
      "command": "mpremote",
      "args": [
        "connect",
        "${input:serialPort}",
        "repl"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "List files on board",
      "type": "process",
      "command": "mpremote",
      "args": [
        "connect",
        "${input:serialPort}",
        "fs",
        "ls"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "serialPort",
      "type": "promptString",
      "description": "Board serial port (Windows: COM4, macOS: /dev/cu.usbmodem1234561)",
      "default": "COM4"
    }
  ]
}
